{
  "name": "qrcode-encoder",
  "type": "module",
  "version": "1.3.0",
  "description": "Zero-dependency QR Code encoder with SVG and terminal renderers.",
  "author": "ZiuChen",
  "license": "MIT",
  "exports": {
    ".": "./dist/index.mjs",
    "./encoder": "./dist/encoder/index.mjs",
    "./renderers/canvas": "./dist/renderers/canvas.mjs",
    "./renderers/png": "./dist/renderers/png.mjs",
    "./renderers/svg": "./dist/renderers/svg.mjs",
    "./renderers/terminal": "./dist/renderers/terminal.mjs",
    "./package.json": "./package.json"
  },
  "browser": "./dist/iife/qrcode-encoder.iife.js",
  "files": [
    "dist"
  ],
  "keywords": [
    "qr-code",
    "encoder",
    "svg",
    "terminal",
    "typescript",
    "wechat-mini-program"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "bumpp": "^12.3.0",
    "jsqr": "^1.4.0",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:ZiuChen/qrcode-encoder.git"
  },
  "packageManager": "pnpm@12.21.0"
}
