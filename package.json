{
  "name": "qrcode-encoder-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "pnpm --filter website run dev",
    "build": "pnpm --filter qrcode-encoder run build && pnpm --filter website run build",
    "test": "pnpm --filter qrcode-encoder run test",
    "typecheck": "pnpm --filter qrcode-encoder run typecheck"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
